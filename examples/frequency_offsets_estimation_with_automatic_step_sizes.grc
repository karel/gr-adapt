- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nFirst order auto-regressive channel model.:\n\nThis implements\
      \ a simple AR(1) channel model, where each tap varies with variance sigma2_q.\n\
      \n\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Embedded Python Block for AR(1) Channel Model - each tap varies with\
      \ variance sigma2_q\"\"\"\n\n    def __init__(self, taps=[1 + 0j, 0 + 0j], alpha=0.9999,\
      \ sigma2_q=1e-10):  # only default arguments here\n        \"\"\"arguments to\
      \ this function show up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n\
      \            self,\n            name='AR(1) Channel Model',   # will show up\
      \ in GRC\n            in_sig=[np.complex64],\n            out_sig=[np.complex64]\n\
      \        )\n\n        self.taps = taps\n        self.M = len(self.taps)\n  \
      \      self.alpha = alpha\n        self.sigma2_q = sigma2_q\n\n        self.theta\
      \ = np.zeros(self.M, dtype=np.complex64)\n        self.history = np.zeros(self.M-1,\
      \ dtype=np.complex64)\n\n    def work(self, input_items, output_items):\n  \
      \      N = len(input_items[0])\n        in0 = np.concatenate((self.history,\
      \ input_items[0]))\n\n        q = np.random.normal(0, np.sqrt(self.sigma2_q),\
      \ (N, self.M)) + 1j * np.random.normal(0, np.sqrt(self.sigma2_q), (N, self.M))\n\
      \        for n in range(N):\n            self.theta = self.alpha * self.theta\
      \ + q[n, :]\n            taps = self.taps + self.theta\n            output_items[0][n]\
      \ = np.vdot(taps, in0[n:n+self.M])\n        self.history = in0[-(self.M-1):]\n\
      \        return N\n"
    affinity: ''
    alias: ''
    alpha: '0.9999'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    sigma2_q: (10 ** (gui_sigma2_q/10))
    taps: '[1.2-1j, 0.5+0.3j, 0.3+0.4j]'
  states:
    _io_cache: ('AR(1) Channel Model', 'blk', [('taps', '[(1+0j), 0j]'), ('alpha',
      '0.9999'), ('sigma2_q', '1e-10')], [('0', 'complex', 1)], [('0', 'complex',
      1)], 'Embedded Python Block for AR(1) Channel Model - each tap varies with variance
      sigma2_q', ['alpha', 'sigma2_q', 'taps'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 568.0]
    rotation: 0
    state: enabled
